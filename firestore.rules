rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 37MusicStudio Firestore Security Rules — Phase 02 (Master Data & Auth)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function businessPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function memberPath(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }

    function studioPath(businessId, studioId) {
      return /databases/$(database)/documents/businesses/$(businessId)/studios/$(studioId);
    }

    function settingPath(businessId, settingId) {
      return /databases/$(database)/documents/businesses/$(businessId)/settings/$(settingId);
    }

    function ledgerEntryPath(businessId, entryId) {
      return /databases/$(database)/documents/businesses/$(businessId)/ledgerEntries/$(entryId);
    }

    function commissionEntryPath(businessId, entryId) {
      return /databases/$(database)/documents/businesses/$(businessId)/commissionEntries/$(entryId);
    }

    function bookingOperationPath(businessId, operationId) {
      return /databases/$(database)/documents/businesses/$(businessId)/bookingOperations/$(operationId);
    }

    function bookingSessionEventPath(businessId, eventId) {
      return /databases/$(database)/documents/businesses/$(businessId)/bookingSessionEvents/$(eventId);
    }

    function hasMatchingBookingOperationAfter(businessId, bookingId, studioId, data, operationType) {
      let operationId = data.get('lastOperationId', null);
      return operationId is string
        && existsAfter(bookingOperationPath(businessId, operationId))
        && getAfter(bookingOperationPath(businessId, operationId)).data.operationId == operationId
        && getAfter(bookingOperationPath(businessId, operationId)).data.businessId == businessId
        && getAfter(bookingOperationPath(businessId, operationId)).data.bookingId == bookingId
        && getAfter(bookingOperationPath(businessId, operationId)).data.studioId == studioId
        && getAfter(bookingOperationPath(businessId, operationId)).data.operationType == operationType
        && getAfter(bookingOperationPath(businessId, operationId)).data.actorUid == request.auth.uid
        && getAfter(bookingOperationPath(businessId, operationId)).data.actorRole == currentMember(businessId).role
        && getAfter(bookingOperationPath(businessId, operationId)).data.requestId is string
        && getAfter(bookingOperationPath(businessId, operationId)).data.payloadHash == data.get('lastOperationPayloadHash', null);
    }

    function hasMatchingBookingSessionEventAfter(businessId, bookingId, studioId, data, fromStatus) {
      let eventId = data.get('lastSessionEventId', null);
      return eventId is string
        && existsAfter(bookingSessionEventPath(businessId, eventId))
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.eventId == eventId
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.operationId == eventId
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.businessId == businessId
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.bookingId == bookingId
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.studioId == studioId
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.action == data.get('lastSessionEventType', null)
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.fromStatus == fromStatus
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.toStatus == data.sessionStatus
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.actorUid == request.auth.uid
        && getAfter(bookingSessionEventPath(businessId, eventId)).data.actorRole == currentMember(businessId).role;
    }

    function getMemberDataIfPresent(businessId) {
      return isSignedIn() && exists(memberPath(businessId, request.auth.uid))
        ? get(memberPath(businessId, request.auth.uid)).data
        : null;
    }

    function isActiveMemberRecord(m) {
      return m != null && m.status == 'active' && m.uid == request.auth.uid;
    }

    function hasActiveMembership(businessId) {
      return isActiveMemberRecord(getMemberDataIfPresent(businessId));
    }

    function currentMember(businessId) {
      return get(memberPath(businessId, request.auth.uid)).data;
    }

    function isOwner(businessId) {
      let m = getMemberDataIfPresent(businessId);
      return isActiveMemberRecord(m) && m.role == 'owner';
    }

    function canAccessCustomers(businessId) {
      let m = getMemberDataIfPresent(businessId);
      return isActiveMemberRecord(m)
        && (m.role == 'owner' || m.get(['permissions', 'canManageCustomers'], false) == true);
    }

    function canManageGallery(businessId) {
      let m = getMemberDataIfPresent(businessId);
      return isActiveMemberRecord(m)
        && (m.role == 'owner' || m.get(['permissions', 'canManageGallery'], false) == true);
    }

    function canOperateStudioBooking(businessId, studioId) {
      let m = getMemberDataIfPresent(businessId);
      return isActiveMemberRecord(m)
        && (
          m.role == 'owner'
          || (m.get(['permissions', 'canManageBookings'], false) == true && studioId in m.assignedStudioIds)
        );
    }

    function isValidRole(role) {
      return role in ['owner', 'operator'];
    }

    function isValidMemberStatus(status) {
      return status in ['active', 'invited', 'suspended', 'revoked'];
    }

    function isValidNullableString(data, key, maxLen) {
      return !(key in data)
        || data[key] == null
        || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidOperatingHoursMap(hours) {
      return hours is map
        && hours.keys().hasOnly(['openTime', 'closeTime'])
        && hours.openTime is string
        && hours.openTime.size() == 5
        && hours.closeTime is string
        && hours.closeTime.size() == 5
        && hours.openTime < hours.closeTime;
    }

    function isValidUserProfileData(data) {
      return data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'defaultBusinessId',
          'schemaVersion',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 120
        && data.email is string
        && data.email.size() <= 254
        && isValidNullableString(data, 'photoURL', 512)
        && isValidNullableString(data, 'defaultBusinessId', 128)
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidBusinessData(data, businessId) {
      return data.keys().hasOnly([
          'businessId',
          'name',
          'slug',
          'ownerUid',
          'timezone',
          'currency',
          'status',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.businessId == businessId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.ownerUid is string
        && data.timezone is string
        && data.currency is string
        && data.status in ['active', 'inactive']
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidMemberData(data, memberUid) {
      return data.keys().hasOnly([
          'uid',
          'businessId',
          'email',
          'displayName',
          'role',
          'status',
          'assignedStudioIds',
          'permissions',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.uid == memberUid
        && data.businessId is string
        && data.businessId.size() >= 1
        && data.displayName is string
        && data.displayName.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && isValidRole(data.role)
        && isValidMemberStatus(data.status)
        && data.assignedStudioIds is list
        && data.assignedStudioIds.size() <= 50
        && (!('permissions' in data) || data.permissions is map)
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidBusinessProfileData(data, businessId) {
      return data.keys().hasOnly([
          'businessId',
          'displayName',
          'legalName',
          'phone',
          'email',
          'address',
          'timezone',
          'currency',
          'status',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.businessId == businessId
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 120
        && isValidNullableString(data, 'legalName', 160)
        && isValidNullableString(data, 'phone', 32)
        && isValidNullableString(data, 'email', 254)
        && isValidNullableString(data, 'address', 300)
        && data.timezone is string
        && data.timezone.size() >= 2
        && data.currency is string
        && data.currency.size() >= 3
        && data.status in ['active', 'inactive']
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidSettingBase(data, businessId, settingId) {
      return data.businessId == businessId
        && data.settingId == settingId
        && data.configVersion is int
        && data.configVersion >= 1
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidSettingData(data, businessId, settingId) {
      return isValidSettingBase(data, businessId, settingId)
        && (
          (
            settingId == 'business'
            && data.keys().hasOnly([
              'settingId', 'businessId', 'defaultTimezone', 'currency',
              'allowMultiStudio', 'configVersion', 'schemaVersion',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
            && data.defaultTimezone is string
            && data.defaultTimezone.size() >= 2
            && data.currency is string
            && data.currency.size() >= 3
            && data.allowMultiStudio is bool
          )
          || (
            settingId == 'schedule'
            && data.keys().hasOnly([
              'settingId', 'businessId', 'operatingHours', 'slotGranularityMinutes',
              'bufferMinutes', 'configVersion', 'schemaVersion',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
            && isValidOperatingHoursMap(data.operatingHours)
            && data.slotGranularityMinutes in [15, 30, 60]
            && data.bufferMinutes is int
            && data.bufferMinutes >= 0
            && data.bufferMinutes <= 120
          )
          || (
            settingId == 'pricing'
            && data.keys().hasOnly([
              'settingId', 'businessId', 'currency', 'taxPercent',
              'allowOperatorDiscount', 'roundingUnitMinor', 'configVersion', 'schemaVersion',
              'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
            && data.currency is string
            && data.taxPercent is int
            && data.taxPercent >= 0
            && data.taxPercent <= 100
            && data.allowOperatorDiscount is bool
            && data.roundingUnitMinor is int
            && data.roundingUnitMinor >= 1
          )
          || (
            settingId == 'commission'
            && data.keys().hasOnly([
              'settingId', 'businessId', 'defaultMethod', 'defaultRatePercent',
              'defaultFixedAmountMinor', 'basis', 'applyOnStatus', 'configVersion',
              'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
            && data.defaultMethod in ['none', 'percentage', 'fixed_per_booking']
            && data.defaultRatePercent is int
            && data.defaultRatePercent >= 0
            && data.defaultRatePercent <= 100
            && data.defaultFixedAmountMinor is int
            && data.defaultFixedAmountMinor >= 0
            && data.basis in ['subtotal', 'settled_amount']
            && data.applyOnStatus == 'settled'
          )
          || (
            settingId == 'bookingPolicy'
            && data.keys().hasOnly([
              'settingId', 'businessId', 'defaultInitialStatus', 'requireCustomerPhone',
              'allowSameDayReschedule', 'cancellationNoticeMinutes', 'configVersion',
              'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
            ])
            && data.defaultInitialStatus in ['CONFIRMED', 'PENDING_CONFIRMATION']
            && data.requireCustomerPhone is bool
            && data.allowSameDayReschedule is bool
            && data.cancellationNoticeMinutes is int
            && data.cancellationNoticeMinutes >= 0
            && data.cancellationNoticeMinutes <= 10080
          )
        );
    }

    function isValidStudioData(data, businessId, studioId) {
      return data.keys().hasOnly([
          'studioId',
          'businessId',
          'name',
          'code',
          'status',
          'timezone',
          'operatingHours',
          'slotGranularityMinutes',
          'description',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.studioId == studioId
        && data.businessId == businessId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.code is string
        && data.code.size() >= 2
        && data.code.size() <= 20
        && data.status in ['active', 'inactive']
        && data.timezone is string
        && data.timezone.size() >= 2
        && isValidOperatingHoursMap(data.operatingHours)
        && data.slotGranularityMinutes in [15, 30, 60]
        && isValidNullableString(data, 'description', 300)
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidServiceData(data, businessId, serviceId) {
      return data.keys().hasOnly([
          'serviceId',
          'businessId',
          'name',
          'category',
          'pricingModel',
          'durationOptions',
          'basePriceMinor',
          'durationPricesMinor',
          'commissionMethod',
          'commissionValue',
          'applicableStudioIds',
          'active',
          'description',
          'configVersion',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.serviceId == serviceId
        && data.businessId == businessId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 80
        && data.category in ['rehearsal', 'recording', 'mixing', 'mastering']
        && data.pricingModel in ['hourly', 'package', 'fixed_session']
        && data.durationOptions is list
        && data.durationOptions.size() >= 1
        && data.durationOptions.size() <= 12
        && data.basePriceMinor is int
        && data.basePriceMinor >= 0
        && data.durationPricesMinor is map
        && data.commissionMethod in ['inherit', 'none', 'percentage', 'fixed_per_booking']
        && data.commissionValue is int
        && data.commissionValue >= 0
        && (data.commissionMethod != 'percentage' || data.commissionValue <= 100)
        && data.applicableStudioIds is list
        && data.applicableStudioIds.size() <= 50
        && data.active is bool
        && isValidNullableString(data, 'description', 300)
        && data.configVersion is int
        && data.configVersion >= 1
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidCustomerData(data, businessId, customerId) {
      return data.keys().hasOnly([
          'customerId',
          'businessId',
          'name',
          'nameLower',
          'phone',
          'email',
          'bandOrActName',
          'notes',
          'status',
          'schemaVersion',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ])
        && data.customerId == customerId
        && data.businessId == businessId
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 120
        && data.nameLower is string
        && data.nameLower.size() >= 2
        && data.nameLower.size() <= 120
        && data.phone is string
        && data.phone.size() >= 6
        && data.phone.size() <= 24
        && isValidNullableString(data, 'email', 254)
        && isValidNullableString(data, 'bandOrActName', 120)
        && isValidNullableString(data, 'notes', 500)
        && data.status in ['active', 'archived']
        && data.schemaVersion is int
        && data.schemaVersion >= 1;
    }

    function isValidBookingData(data, businessId, bookingId) {
      return data.keys().hasOnly([
          'bookingId', 'businessId', 'studioId', 'serviceId', 'customerId', 'operatorUid',
          'dateKey', 'timezone', 'startTime', 'endTime', 'durationMinutes', 'bufferMinutes',
          'startAt', 'endAt', 'slotIds', 'status',
          'studioSnapshot', 'serviceSnapshot', 'customerSnapshot',
          'priceSnapshot', 'commissionSnapshot',
          'notes', 'cancelReason', 'cancelledBy', 'cancelledAt',
          'checkedInAt', 'checkedInByUid', 'checkedInByName',
          'actualStartAt', 'actualStartByUid', 'actualStartByName',
          'actualEndAt', 'actualEndByUid', 'actualEndByName', 'actualDurationMinutes',
          'noShowAt', 'noShowByUid', 'noShowByName', 'noShowReason',
          'sessionStatus', 'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
          'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
          'completedAt', 'settlement', 'rescheduleCount',
          'schemaVersion', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'
        ])
        && data.bookingId == bookingId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.serviceId is string && data.serviceId.size() >= 1
        && data.customerId is string && data.customerId.size() >= 1
        && isValidNullableString(data, 'operatorUid', 128)
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.timezone is string && data.timezone.size() >= 2
        && data.startTime is string && data.startTime.size() == 5
        && data.endTime is string && data.endTime.size() == 5
        && data.durationMinutes is int && data.durationMinutes >= 15 && data.durationMinutes <= 1440
        && data.bufferMinutes is int && data.bufferMinutes >= 0 && data.bufferMinutes <= 120
        && data.startAt is timestamp
        && data.endAt is timestamp
        && data.endAt > data.startAt
        && data.slotIds is list && data.slotIds.size() >= 1 && data.slotIds.size() <= 96
        && data.status in [
          'PENDING_CONFIRMATION', 'CONFIRMED', 'IN_PROGRESS',
          'COMPLETED_PENDING_SETTLEMENT', 'SETTLEMENT_REVIEW', 'SETTLED',
          'CANCELLED', 'NO_SHOW', 'REJECTED'
        ]
        && (!('sessionStatus' in data) || data.sessionStatus in [
          'PENDING', 'UPCOMING', 'IN_PROGRESS', 'COMPLETED', 'NO_SHOW', 'CANCELLED'
        ])
        && isValidNullableString(data, 'checkedInByUid', 128)
        && isValidNullableString(data, 'checkedInByName', 120)
        && isValidNullableString(data, 'actualStartByUid', 128)
        && isValidNullableString(data, 'actualStartByName', 120)
        && isValidNullableString(data, 'actualEndByUid', 128)
        && isValidNullableString(data, 'actualEndByName', 120)
        && isValidNullableString(data, 'noShowByUid', 128)
        && isValidNullableString(data, 'noShowByName', 120)
        && isValidNullableString(data, 'noShowReason', 300)
        && isValidNullableString(data, 'lastSessionEventId', 180)
        && isValidNullableString(data, 'lastSessionEventType', 30)
        && isValidNullableString(data, 'lastOperationId', 180)
        && isValidNullableString(data, 'lastOperationType', 40)
        && isValidNullableString(data, 'lastOperationPayloadHash', 64)
        && (!('actualDurationMinutes' in data) || data.actualDurationMinutes == null || (data.actualDurationMinutes is int && data.actualDurationMinutes >= 0 && data.actualDurationMinutes <= 10080))
        && (!('checkedInAt' in data) || data.checkedInAt == null || data.checkedInAt is timestamp)
        && (!('actualStartAt' in data) || data.actualStartAt == null || data.actualStartAt is timestamp)
        && (!('actualEndAt' in data) || data.actualEndAt == null || data.actualEndAt is timestamp)
        && (!('noShowAt' in data) || data.noShowAt == null || data.noShowAt is timestamp)
        && (!('lastSessionEventAt' in data) || data.lastSessionEventAt == null || data.lastSessionEventAt is timestamp)
        && (!('completedAt' in data) || data.completedAt == null || data.completedAt is timestamp)
        && (
          !('lastOperationId' in data)
          || (
            data.lastOperationId is string && data.lastOperationId.size() > 0
            && data.lastOperationType in ['booking.create', 'booking.decision', 'booking.reschedule', 'booking.session']
            && data.lastOperationPayloadHash is string
            && data.lastOperationPayloadHash.matches('^[a-f0-9]{16,64}
        && data.studioSnapshot is map
        && data.serviceSnapshot is map
        && data.customerSnapshot is map
        && data.priceSnapshot is map
        && data.priceSnapshot.currency == 'IDR'
        && data.priceSnapshot.totalMinor is int && data.priceSnapshot.totalMinor >= 0
        && data.priceSnapshot.discountMinor is int && data.priceSnapshot.discountMinor >= 0
        && data.commissionSnapshot is map
        && data.commissionSnapshot.currency == 'IDR'
        && data.commissionSnapshot.amountMinor is int && data.commissionSnapshot.amountMinor >= 0
        && (!('settlement' in data) || data.settlement == null || data.settlement is map)
        && isValidNullableString(data, 'notes', 500)
        && isValidNullableString(data, 'cancelReason', 300)
        && isValidNullableString(data, 'cancelledBy', 128)
        && data.rescheduleCount is int && data.rescheduleCount >= 0
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidBookingSessionUpdate(businessId, bookingId, oldData, newData) {
      let fromSessionStatus = oldData.get(
        'sessionStatus',
        oldData.status == 'PENDING_CONFIRMATION'
          ? 'PENDING'
          : oldData.status == 'IN_PROGRESS'
            ? 'IN_PROGRESS'
            : oldData.status in ['COMPLETED_PENDING_SETTLEMENT', 'SETTLEMENT_REVIEW', 'SETTLED']
              ? 'COMPLETED'
              : oldData.status == 'NO_SHOW'
                ? 'NO_SHOW'
                : oldData.status in ['CANCELLED', 'REJECTED']
                  ? 'CANCELLED'
                  : 'UPCOMING'
      );
      return canOperateStudioBooking(businessId, oldData.studioId)
        && newData.updatedBy == request.auth.uid
        && newData.updatedAt == request.time
        && newData.lastOperationType == 'booking.session'
        && newData.lastOperationId == newData.lastSessionEventId
        && newData.lastOperationPayloadHash is string
        && newData.lastSessionEventAt == request.time
        && hasMatchingBookingOperationAfter(
          businessId, bookingId, oldData.studioId, newData, 'booking.session'
        )
        && hasMatchingBookingSessionEventAfter(
          businessId, bookingId, oldData.studioId, newData, fromSessionStatus
        )
        && (
          (
            newData.lastSessionEventType == 'check_in'
            && oldData.status == 'CONFIRMED'
            && fromSessionStatus == 'UPCOMING'
            && newData.status == oldData.status
            && newData.sessionStatus == 'UPCOMING'
            && oldData.get('checkedInAt', null) == null
            && newData.checkedInAt == request.time
            && newData.checkedInByUid == request.auth.uid
            && newData.checkedInByName is string
            && newData.diff(oldData).affectedKeys().hasOnly([
              'sessionStatus', 'checkedInAt', 'checkedInByUid', 'checkedInByName',
              'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
              'updatedBy', 'updatedAt'
            ])
          )
          || (
            newData.lastSessionEventType == 'start'
            && oldData.status == 'CONFIRMED'
            && fromSessionStatus == 'UPCOMING'
            && newData.status == oldData.status
            && newData.sessionStatus == 'IN_PROGRESS'
            && oldData.get('actualStartAt', null) == null
            && newData.actualStartAt == request.time
            && newData.actualStartByUid == request.auth.uid
            && newData.actualStartByName is string
            && newData.diff(oldData).affectedKeys().hasOnly([
              'sessionStatus', 'actualStartAt', 'actualStartByUid', 'actualStartByName',
              'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
              'updatedBy', 'updatedAt'
            ])
          )
          || (
            newData.lastSessionEventType == 'complete'
            && oldData.status == 'CONFIRMED'
            && fromSessionStatus == 'IN_PROGRESS'
            && oldData.get('actualStartAt', null) is timestamp
            && request.time >= oldData.actualStartAt
            && newData.status == 'COMPLETED_PENDING_SETTLEMENT'
            && newData.sessionStatus == 'COMPLETED'
            && newData.actualEndAt == request.time
            && newData.actualEndByUid == request.auth.uid
            && newData.actualEndByName is string
            && newData.completedAt == request.time
            && newData.actualDurationMinutes is int
            && newData.actualDurationMinutes >= math.floor(
              (request.time.toMillis() - oldData.actualStartAt.toMillis()) / 60000
            ) - 1
            && newData.actualDurationMinutes <= math.floor(
              (request.time.toMillis() - oldData.actualStartAt.toMillis()) / 60000
            ) + 1
            && newData.actualDurationMinutes <= 10080
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'sessionStatus', 'actualEndAt', 'actualEndByUid', 'actualEndByName',
              'actualDurationMinutes', 'completedAt',
              'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
              'updatedBy', 'updatedAt'
            ])
          )
          || (
            newData.lastSessionEventType == 'no_show'
            && oldData.status == 'CONFIRMED'
            && fromSessionStatus == 'UPCOMING'
            && oldData.get('checkedInAt', null) == null
            && oldData.startAt is timestamp
            && request.time >= oldData.startAt + duration.value(15, 'm')
            && newData.status == 'NO_SHOW'
            && newData.sessionStatus == 'NO_SHOW'
            && newData.noShowAt == request.time
            && newData.noShowByUid == request.auth.uid
            && newData.noShowByName is string
            && newData.noShowReason is string
            && newData.noShowReason.size() >= 4
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'sessionStatus', 'noShowAt', 'noShowByUid', 'noShowByName', 'noShowReason',
              'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
              'updatedBy', 'updatedAt'
            ])
          )
          || (
            newData.lastSessionEventType == 'cancel'
            && oldData.status in ['PENDING_CONFIRMATION', 'CONFIRMED', 'IN_PROGRESS']
            && fromSessionStatus in ['PENDING', 'UPCOMING', 'IN_PROGRESS']
            && newData.status == 'CANCELLED'
            && newData.sessionStatus == 'CANCELLED'
            && newData.cancelReason is string
            && newData.cancelReason.size() >= 3
            && newData.cancelledBy == request.auth.uid
            && newData.cancelledAt == request.time
            && newData.get('actualStartAt', null) == oldData.get('actualStartAt', null)
            && newData.get('actualStartByUid', null) == oldData.get('actualStartByUid', null)
            && newData.get('actualStartByName', null) == oldData.get('actualStartByName', null)
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'sessionStatus', 'cancelReason', 'cancelledBy', 'cancelledAt',
              'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
              'updatedBy', 'updatedAt'
            ])
          )
          || (
            newData.lastSessionEventType == 'reject'
            && oldData.status == 'PENDING_CONFIRMATION'
            && fromSessionStatus == 'PENDING'
            && newData.status == 'REJECTED'
            && newData.sessionStatus == 'CANCELLED'
            && newData.cancelReason is string
            && newData.cancelReason.size() >= 3
            && newData.cancelledBy == request.auth.uid
            && newData.cancelledAt == request.time
            && newData.diff(oldData).affectedKeys().hasOnly([
              'status', 'sessionStatus', 'cancelReason', 'cancelledBy', 'cancelledAt',
              'lastSessionEventId', 'lastSessionEventAt', 'lastSessionEventType',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash',
              'updatedBy', 'updatedAt'
            ])
          )
        );
    }

    function isValidBookingSlotData(data, businessId, slotId) {
      return data.keys().hasOnly([
          'slotId', 'businessId', 'studioId', 'dateKey', 'bucketIndex', 'slotTime',
          'kind', 'status', 'bookingId', 'slotStartAt', 'slotEndAt',
          'reservedBy', 'reservedAt', 'releasedAt', 'schemaVersion', 'updatedAt', 'updatedBy'
        ])
        && data.slotId == slotId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.bucketIndex is int && data.bucketIndex >= 0 && data.bucketIndex <= 95
        && (
          (data.bucketIndex < 10 && slotId == data.studioId + '__' + data.dateKey + '__0' + string(data.bucketIndex))
          || (data.bucketIndex >= 10 && slotId == data.studioId + '__' + data.dateKey + '__' + string(data.bucketIndex))
        )
        && data.slotTime is string && data.slotTime.matches('^([01][0-9]|2[0-3]):(00|15|30|45)$')
        && data.kind in ['session', 'buffer']
        && data.status in ['active', 'released']
        && (
          (data.status == 'active' && data.bookingId is string && data.bookingId.size() >= 1)
          || (data.status == 'released' && data.bookingId == null)
        )
        && data.slotStartAt is timestamp
        && data.slotEndAt is timestamp
        && data.slotEndAt > data.slotStartAt
        && data.reservedBy is string && data.reservedBy.size() >= 1
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidActivityLogData(data, businessId, eventId) {
      return data.keys().hasOnly([
          'eventId', 'businessId', 'studioId', 'eventType', 'entityType', 'entityId',
          'operationId', 'actorUid', 'actorRole', 'beforeStatus', 'afterStatus',
          'reason', 'summary', 'schemaVersion', 'createdAt'
        ])
        && data.eventId == eventId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.entityType in ['booking', 'ledger_entry', 'commission_entry']
        && data.entityId is string && data.entityId.size() >= 1
        && data.operationId is string && data.operationId.size() >= 1
        && data.eventType in [
          'booking.created', 'booking.confirmed', 'booking.started',
          'booking.completed', 'booking.cancelled', 'booking.no_show', 'booking.rescheduled',
          'booking.settled', 'booking.settlement_review', 'ledger.adjusted', 'commission.adjusted'
        ]
        && data.actorUid == request.auth.uid
        && data.actorRole == currentMember(businessId).role
        && isValidNullableString(data, 'beforeStatus', 60)
        && data.afterStatus is string && data.afterStatus.size() >= 1
        && isValidNullableString(data, 'reason', 300)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidLedgerEntryData(data, businessId, entryId) {
      return data.keys().hasOnly([
          'entryId', 'businessId', 'bookingId', 'studioId', 'dateKey',
          'type', 'direction', 'amountMinor', 'currency', 'paymentMethod',
          'reference', 'notes', 'relatedEntryId', 'reason', 'schemaVersion',
          'createdAt', 'createdBy'
        ])
        && data.entryId == entryId
        && data.businessId == businessId
        && data.bookingId is string && data.bookingId.size() >= 1
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.type in ['PAYMENT_RECEIVED', 'REFUND', 'ADJUSTMENT', 'REVERSAL']
        && data.direction in ['inflow', 'outflow']
        && data.amountMinor is int && data.amountMinor >= 0
        && data.currency == 'IDR'
        && (!('paymentMethod' in data) || data.paymentMethod == null || data.paymentMethod in ['cash', 'transfer', 'qris', 'card', 'other'])
        && isValidNullableString(data, 'reference', 120)
        && isValidNullableString(data, 'notes', 300)
        && isValidNullableString(data, 'relatedEntryId', 160)
        && isValidNullableString(data, 'reason', 300)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidCommissionEntryData(data, businessId, entryId) {
      return data.keys().hasOnly([
          'entryId', 'businessId', 'bookingId', 'studioId', 'dateKey', 'operatorUid',
          'entryType', 'direction', 'amountMinor', 'currency', 'method', 'rateOrValue',
          'basis', 'basisAmountMinor', 'source', 'relatedEntryId', 'reason', 'status',
          'schemaVersion', 'createdAt', 'createdBy'
        ])
        && data.entryId == entryId
        && data.businessId == businessId
        && data.bookingId is string && data.bookingId.size() >= 1
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.operatorUid is string && data.operatorUid.size() >= 1
        && data.entryType in ['EARNED', 'ADJUSTMENT', 'REVERSAL']
        && data.direction in ['credit', 'debit']
        && data.amountMinor is int && data.amountMinor >= 0
        && data.currency == 'IDR'
        && data.method in ['inherit', 'none', 'percentage', 'fixed_per_booking']
        && data.rateOrValue is int && data.rateOrValue >= 0
        && data.basis in ['subtotal', 'settled_amount']
        && data.basisAmountMinor is int && data.basisAmountMinor >= 0
        && data.source is string && data.source.size() >= 1
        && isValidNullableString(data, 'relatedEntryId', 160)
        && isValidNullableString(data, 'reason', 300)
        && data.status in ['RECORDED', 'ADJUSTED', 'REVERSED']
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidNotificationData(data, businessId, notificationId) {
      return data.keys().hasOnly([
          'notificationId', 'businessId', 'studioId', 'recipientUid', 'eventId',
          'type', 'channel', 'entityType', 'entityId', 'title', 'message',
          'actionPath', 'readAt', 'createdBy', 'createdAt', 'schemaVersion'
        ])
        && data.notificationId == notificationId
        && data.businessId == businessId
        && isValidNullableString(data, 'studioId', 128)
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid != '*'
        && data.eventId is string && data.eventId.size() >= 1
        && data.type in [
          'BOOKING_CREATED', 'BOOKING_CONFIRMED', 'BOOKING_STARTED',
          'BOOKING_COMPLETED', 'BOOKING_CANCELLED', 'BOOKING_RESCHEDULED',
          'BOOKING_SETTLED', 'SETTLEMENT_REVIEW_REQUIRED', 'TEAM_ASSIGNMENT_UPDATED'
        ]
        && data.channel == 'in_app'
        && data.entityType in ['booking', 'settlement', 'member']
        && data.entityId is string && data.entityId.size() >= 1
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && isValidNullableString(data, 'actionPath', 160)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidGalleryAssetData(data, businessId, assetId) {
      return data.keys().hasOnly([
          'assetId', 'businessId', 'studioId', 'publicId', 'secureUrl', 'format',
          'width', 'height', 'bytes', 'caption', 'altText', 'order', 'status',
          'uploadedBy', 'uploadedAt', 'createdAt', 'updatedAt', 'updatedBy', 'schemaVersion'
        ])
        && data.assetId == assetId
        && data.businessId == businessId
        && isValidNullableString(data, 'studioId', 100)
        && data.publicId is string && data.publicId.size() >= 1 && data.publicId.size() <= 240
        && data.secureUrl is string
        && data.secureUrl.size() > 27 && data.secureUrl.size() <= 500
        && data.secureUrl.matches('^https://res\\.cloudinary\\.com/.+')
        && data.format in ['jpg', 'jpeg', 'png', 'webp']
        && data.width is int && data.width >= 1 && data.width <= 20000
        && data.height is int && data.height >= 1 && data.height <= 20000
        && data.bytes is int && data.bytes >= 1 && data.bytes <= 52428800
        && isValidNullableString(data, 'caption', 200)
        && isValidNullableString(data, 'altText', 200)
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.status in ['active', 'archived']
        && data.uploadedBy is string && data.uploadedBy.size() >= 1
        && isValidNullableString(data, 'updatedBy', 128)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    // -------------------------------------------------------------------------
    // Global user profile (must NEVER contain role/permission/business access)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && isValidUserProfileData(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
        && isValidUserProfileData(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection group query for discovering own business memberships
    // -------------------------------------------------------------------------
    match /{path=**}/members/{memberUid} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Tenant-scoped business root & master data (Phase 01 + Phase 02)
    // -------------------------------------------------------------------------
    match /businesses/{businessId} {
      allow get: if hasActiveMembership(businessId);
      allow list: if false;

      // Initial business creation (atomic with founder active owner doc)
      allow create: if isSignedIn()
        && !exists(businessPath(businessId))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidBusinessData(request.resource.data, businessId)
        && getAfter(memberPath(businessId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberPath(businessId, request.auth.uid)).data.role == 'owner'
        && getAfter(memberPath(businessId, request.auth.uid)).data.status == 'active';

      allow update: if isOwner(businessId)
        && isValidBusinessData(request.resource.data, businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isOwner(businessId) || (isSelf(memberUid) && (resource == null || resource.data.uid == request.auth.uid));
        allow list: if isOwner(businessId);

        allow create: if isValidMemberData(request.resource.data, memberUid)
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            isOwner(businessId)
            || (
              isSelf(memberUid)
              && !exists(businessPath(businessId))
              && request.resource.data.role == 'owner'
              && request.resource.data.status == 'active'
              && getAfter(businessPath(businessId)).data.ownerUid == request.auth.uid
              && getAfter(businessPath(businessId)).data.businessId == businessId
            )
          );

        allow update: if isOwner(businessId)
          && isValidMemberData(request.resource.data, memberUid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (!isSelf(memberUid) || (request.resource.data.role == 'owner' && request.resource.data.status == 'active'));

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Business Profile (`profile/main`)
      // -----------------------------------------------------------------------
      match /profile/{docId} {
        allow get: if docId == 'main' && hasActiveMembership(businessId);
        allow list: if false;

        allow create: if isOwner(businessId)
          && docId == 'main'
          && isValidBusinessProfileData(request.resource.data, businessId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && docId == 'main'
          && isValidBusinessProfileData(request.resource.data, businessId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Settings (`business | schedule | pricing | commission | bookingPolicy`)
      // -----------------------------------------------------------------------
      match /settings/{settingId} {
        allow get, list: if hasActiveMembership(businessId);

        allow create: if isOwner(businessId)
          && settingId in ['business', 'schedule', 'pricing', 'commission', 'bookingPolicy']
          && isValidSettingData(request.resource.data, businessId, settingId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && settingId in ['business', 'schedule', 'pricing', 'commission', 'bookingPolicy']
          && isValidSettingData(request.resource.data, businessId, settingId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.settingId == resource.data.settingId
          && request.resource.data.configVersion >= resource.data.configVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Studios / Rooms (Owner full; Operator read assigned only)
      // -----------------------------------------------------------------------
      match /studios/{studioId} {
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && studioId in currentMember(businessId).assignedStudioIds
            && (resource == null || resource.data.studioId == studioId)
          );
        allow list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if isOwner(businessId)
          && isValidStudioData(request.resource.data, businessId, studioId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && isValidStudioData(request.resource.data, businessId, studioId)
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Services & Versioned Pricing Config
      // -----------------------------------------------------------------------
      match /services/{serviceId} {
        allow get, list: if hasActiveMembership(businessId);

        allow create: if isOwner(businessId)
          && isValidServiceData(request.resource.data, businessId, serviceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && isValidServiceData(request.resource.data, businessId, serviceId)
          && request.resource.data.serviceId == resource.data.serviceId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.configVersion >= resource.data.configVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Customers (Owner full CRUD sans delete; Operator active operational access)
      // -----------------------------------------------------------------------
      match /customers/{customerId} {
        allow get, list: if canAccessCustomers(businessId);

        allow create: if canAccessCustomers(businessId)
          && isValidCustomerData(request.resource.data, businessId, customerId)
          && (isOwner(businessId) || request.resource.data.status == 'active')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canAccessCustomers(businessId)
          && isValidCustomerData(request.resource.data, businessId, customerId)
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.businessId == resource.data.businessId
          && (isOwner(businessId) || request.resource.data.status == resource.data.status)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 03: Booking Engine, Atomic Slot Locks & Append-Only Activity Logs
      // -----------------------------------------------------------------------
      match /bookings/{bookingId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              resource == null
              || resource.data.studioId in currentMember(businessId).assignedStudioIds
            )
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidBookingData(request.resource.data, businessId, bookingId)
          && request.resource.data.status in ['PENDING_CONFIRMATION', 'CONFIRMED']
          && request.resource.data.rescheduleCount == 0
          && exists(studioPath(businessId, request.resource.data.studioId))
          && get(studioPath(businessId, request.resource.data.studioId)).data.status == 'active'
          && (
            request.resource.data.priceSnapshot.discountMinor == 0
            || isOwner(businessId)
            || (
              currentMember(businessId).get(['permissions', 'canApplyDiscount'], false) == true
              && exists(settingPath(businessId, 'pricing'))
              && get(settingPath(businessId, 'pricing')).data.allowOperatorDiscount == true
            )
          )
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastOperationType == 'booking.create'
          && hasMatchingBookingOperationAfter(
            businessId, bookingId, request.resource.data.studioId,
            request.resource.data, 'booking.create'
          )
          && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'create';

        allow update: if isValidBookingSessionUpdate(
            businessId, bookingId, resource.data, request.resource.data
          )
          || (
            // Request decision: confirm only. Rejection/cancellation are session actions.
            canOperateStudioBooking(businessId, resource.data.studioId)
            && resource.data.status == 'PENDING_CONFIRMATION'
            && request.resource.data.status == 'CONFIRMED'
            && request.resource.data.sessionStatus == 'UPCOMING'
            && request.resource.data.lastOperationType == 'booking.decision'
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'sessionStatus', 'lastOperationId',
              'lastOperationType', 'lastOperationPayloadHash', 'updatedBy', 'updatedAt'
            ])
            && hasMatchingBookingOperationAfter(
              businessId, bookingId, resource.data.studioId,
              request.resource.data, 'booking.decision'
            )
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'decision:CONFIRMED'
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.resultBookingStatus == 'CONFIRMED'
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.resultSessionStatus == 'UPCOMING'
          )
          || (
            // Atomic reschedule: marker and all slot changes share one transaction.
            canOperateStudioBooking(businessId, resource.data.studioId)
            && resource.data.status in ['PENDING_CONFIRMATION', 'CONFIRMED']
            && request.resource.data.status == resource.data.status
            && request.resource.data.rescheduleCount == resource.data.rescheduleCount + 1
            && request.resource.data.lastOperationType == 'booking.reschedule'
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'dateKey', 'timezone', 'startTime', 'endTime', 'durationMinutes',
              'bufferMinutes', 'startAt', 'endAt', 'slotIds',
              'priceSnapshot', 'commissionSnapshot', 'rescheduleCount', 'updatedBy', 'updatedAt',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash'
            ])
            && hasMatchingBookingOperationAfter(
              businessId, bookingId, resource.data.studioId,
              request.resource.data, 'booking.reschedule'
            )
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'reschedule'
            && request.resource.data.endAt > request.resource.data.startAt
            && request.resource.data.slotIds is list
            && request.resource.data.slotIds.size() >= 1
            && request.resource.data.slotIds.size() <= 96
            && (
              request.resource.data.durationMinutes != resource.data.durationMinutes
              || (
                request.resource.data.priceSnapshot == resource.data.priceSnapshot
                && request.resource.data.commissionSnapshot == resource.data.commissionSnapshot
              )
            )
          )
          || (
            // Owner-only Finance handoff remains unchanged.
            isOwner(businessId)
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'settlement', 'updatedBy', 'updatedAt'
            ])
            && (
              (
                resource.data.status == 'COMPLETED_PENDING_SETTLEMENT'
                && request.resource.data.status == 'SETTLEMENT_REVIEW'
              )
              || (
                resource.data.status in ['COMPLETED_PENDING_SETTLEMENT', 'SETTLEMENT_REVIEW']
                && request.resource.data.status == 'SETTLED'
                && request.resource.data.settlement is map
                && request.resource.data.settlement.paidAmountMinor is int
                && request.resource.data.settlement.paidAmountMinor >= 0
                && request.resource.data.settlement.ledgerEntryId == ('settlement_payment__' + bookingId)
                && request.resource.data.settlement.commissionEntryId == ('commission_earned__' + bookingId)
                && existsAfter(ledgerEntryPath(businessId, 'settlement_payment__' + bookingId))
                && existsAfter(commissionEntryPath(businessId, 'commission_earned__' + bookingId))
              )
            )
          );

        allow delete: if false;
      }

      // Phase 10: immutable operation markers for idempotent booking mutations.
      match /bookingOperations/{operationId} {
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              resource == null
              || resource.data.studioId in currentMember(businessId).assignedStudioIds
            )
          );
        allow list: if false;

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && request.resource.data.keys().hasOnly([
            'operationId', 'requestId', 'payloadHash', 'operationType', 'action',
            'businessId', 'bookingId', 'studioId', 'actorUid', 'actorRole',
            'resultBookingStatus', 'resultSessionStatus', 'schemaVersion', 'createdAt'
          ])
          && request.resource.data.operationId == operationId
          && request.resource.data.businessId == businessId
          && request.resource.data.bookingId is string
          && request.resource.data.studioId is string
          && request.resource.data.operationType in [
            'booking.create', 'booking.decision', 'booking.reschedule', 'booking.session'
          ]
          && request.resource.data.action is string
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == currentMember(businessId).role
          && request.resource.data.requestId is string
          && request.resource.data.requestId.size() >= 8
          && request.resource.data.payloadHash is string
          && request.resource.data.payloadHash.matches('^[a-f0-9]{16,64}
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              (resource != null && resource.data.studioId in currentMember(businessId).assignedStudioIds)
              || (
                resource == null
                && slotId.split('__').size() == 3
                && slotId.split('__')[0] in currentMember(businessId).assignedStudioIds
              )
            )
          );

        allow list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidBookingSlotData(request.resource.data, businessId, slotId)
          && request.resource.data.status == 'active'
          && request.resource.data.reservedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.reservedAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canOperateStudioBooking(businessId, resource.data.studioId)
          && isValidBookingSlotData(request.resource.data, businessId, slotId)
          && request.resource.data.slotId == resource.data.slotId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.bucketIndex == resource.data.bucketIndex
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'released' && request.resource.data.status == 'active')
            || (resource.data.status == 'active' && request.resource.data.status == 'released')
            || (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && request.resource.data.bookingId == resource.data.bookingId
            )
          );

        allow delete: if false;
      }

      match /activityLogs/{eventId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource != null
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidActivityLogData(request.resource.data, businessId, eventId)
          && (
            isOwner(businessId)
            || (
              request.resource.data.entityType == 'booking'
              && !(request.resource.data.eventType in [
                'booking.settled', 'booking.settlement_review', 'ledger.adjusted', 'commission.adjusted'
              ])
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 04: Immutable Financial Ledger & Operator Commission Entries
      // -----------------------------------------------------------------------
      match /ledgerEntries/{entryId} {
        allow get, list: if isOwner(businessId);

        allow create: if isOwner(businessId)
          && isValidLedgerEntryData(request.resource.data, businessId, entryId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.relatedEntryId == null
            || exists(ledgerEntryPath(businessId, request.resource.data.relatedEntryId))
          );

        allow update, delete: if false;
      }

      match /commissionEntries/{entryId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource != null
            && resource.data.operatorUid == request.auth.uid
          );

        allow create: if isOwner(businessId)
          && isValidCommissionEntryData(request.resource.data, businessId, entryId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.relatedEntryId == null
            || exists(commissionEntryPath(businessId, request.resource.data.relatedEntryId))
          );

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 05: Scoped In-App Notifications
      // -----------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get, list: if hasActiveMembership(businessId)
          && resource != null
          && resource.data.recipientUid == request.auth.uid;

        allow create: if isValidNotificationData(request.resource.data, businessId, notificationId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null
          && exists(memberPath(businessId, request.resource.data.recipientUid))
          && (
            isOwner(businessId)
            || (
              hasActiveMembership(businessId)
              && request.resource.data.studioId != null
              && request.resource.data.studioId in currentMember(businessId).assignedStudioIds
              && request.resource.data.type in [
                'BOOKING_CREATED', 'BOOKING_CONFIRMED', 'BOOKING_STARTED',
                'BOOKING_COMPLETED', 'BOOKING_CANCELLED', 'BOOKING_RESCHEDULED'
              ]
            )
          );

        allow update: if hasActiveMembership(businessId)
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 06: Gallery Assets (Cloudinary Metadata & Soft-Archive)
      // -----------------------------------------------------------------------
      match /galleryAssets/{assetId} {
        allow read: if hasActiveMembership(businessId);

        allow create: if canManageGallery(businessId)
          && isValidGalleryAssetData(request.resource.data, businessId, assetId)
          && request.resource.data.status == 'active'
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (
            (
              canManageGallery(businessId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['studioId', 'caption', 'altText', 'order', 'updatedBy', 'updatedAt'])
            )
            || (
              isOwner(businessId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['studioId', 'caption', 'altText', 'order', 'status', 'updatedBy', 'updatedAt'])
              && request.resource.data.status in ['active', 'archived']
            )
          )
          && isValidNullableString(request.resource.data, 'studioId', 100)
          && isValidNullableString(request.resource.data, 'caption', 200)
          && isValidNullableString(request.resource.data, 'altText', 200)
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 10000
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.publicId == resource.data.publicId
          && request.resource.data.secureUrl == resource.data.secureUrl
          && request.resource.data.format == resource.data.format
          && request.resource.data.width == resource.data.width
          && request.resource.data.height == resource.data.height
          && request.resource.data.bytes == resource.data.bytes
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.uploadedAt == resource.data.uploadedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.assetId == resource.data.assetId;

        allow delete: if false;
      }
    }

    // Default deny fallback for every other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
          )
        )
        && data.studioSnapshot is map
        && data.serviceSnapshot is map
        && data.customerSnapshot is map
        && data.priceSnapshot is map
        && data.priceSnapshot.currency == 'IDR'
        && data.priceSnapshot.totalMinor is int && data.priceSnapshot.totalMinor >= 0
        && data.priceSnapshot.discountMinor is int && data.priceSnapshot.discountMinor >= 0
        && data.commissionSnapshot is map
        && data.commissionSnapshot.currency == 'IDR'
        && data.commissionSnapshot.amountMinor is int && data.commissionSnapshot.amountMinor >= 0
        && (!('settlement' in data) || data.settlement == null || data.settlement is map)
        && isValidNullableString(data, 'notes', 500)
        && isValidNullableString(data, 'cancelReason', 300)
        && isValidNullableString(data, 'cancelledBy', 128)
        && data.rescheduleCount is int && data.rescheduleCount >= 0
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidBookingSlotData(data, businessId, slotId) {
      return data.keys().hasOnly([
          'slotId', 'businessId', 'studioId', 'dateKey', 'bucketIndex', 'slotTime',
          'kind', 'status', 'bookingId', 'slotStartAt', 'slotEndAt',
          'reservedBy', 'reservedAt', 'releasedAt', 'schemaVersion', 'updatedAt', 'updatedBy'
        ])
        && data.slotId == slotId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.bucketIndex is int && data.bucketIndex >= 0 && data.bucketIndex <= 95
        && (
          (data.bucketIndex < 10 && slotId == data.studioId + '__' + data.dateKey + '__0' + string(data.bucketIndex))
          || (data.bucketIndex >= 10 && slotId == data.studioId + '__' + data.dateKey + '__' + string(data.bucketIndex))
        )
        && data.slotTime is string && data.slotTime.matches('^([01][0-9]|2[0-3]):(00|15|30|45)$')
        && data.kind in ['session', 'buffer']
        && data.status in ['active', 'released']
        && (
          (data.status == 'active' && data.bookingId is string && data.bookingId.size() >= 1)
          || (data.status == 'released' && data.bookingId == null)
        )
        && data.slotStartAt is timestamp
        && data.slotEndAt is timestamp
        && data.slotEndAt > data.slotStartAt
        && data.reservedBy is string && data.reservedBy.size() >= 1
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidActivityLogData(data, businessId, eventId) {
      return data.keys().hasOnly([
          'eventId', 'businessId', 'studioId', 'eventType', 'entityType', 'entityId',
          'operationId', 'actorUid', 'actorRole', 'beforeStatus', 'afterStatus',
          'reason', 'summary', 'schemaVersion', 'createdAt'
        ])
        && data.eventId == eventId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.entityType in ['booking', 'ledger_entry', 'commission_entry']
        && data.entityId is string && data.entityId.size() >= 1
        && data.operationId is string && data.operationId.size() >= 1
        && data.eventType in [
          'booking.created', 'booking.confirmed', 'booking.started',
          'booking.completed', 'booking.cancelled', 'booking.no_show', 'booking.rescheduled',
          'booking.settled', 'booking.settlement_review', 'ledger.adjusted', 'commission.adjusted'
        ]
        && data.actorUid == request.auth.uid
        && data.actorRole == currentMember(businessId).role
        && isValidNullableString(data, 'beforeStatus', 60)
        && data.afterStatus is string && data.afterStatus.size() >= 1
        && isValidNullableString(data, 'reason', 300)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidLedgerEntryData(data, businessId, entryId) {
      return data.keys().hasOnly([
          'entryId', 'businessId', 'bookingId', 'studioId', 'dateKey',
          'type', 'direction', 'amountMinor', 'currency', 'paymentMethod',
          'reference', 'notes', 'relatedEntryId', 'reason', 'schemaVersion',
          'createdAt', 'createdBy'
        ])
        && data.entryId == entryId
        && data.businessId == businessId
        && data.bookingId is string && data.bookingId.size() >= 1
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.type in ['PAYMENT_RECEIVED', 'REFUND', 'ADJUSTMENT', 'REVERSAL']
        && data.direction in ['inflow', 'outflow']
        && data.amountMinor is int && data.amountMinor >= 0
        && data.currency == 'IDR'
        && (!('paymentMethod' in data) || data.paymentMethod == null || data.paymentMethod in ['cash', 'transfer', 'qris', 'card', 'other'])
        && isValidNullableString(data, 'reference', 120)
        && isValidNullableString(data, 'notes', 300)
        && isValidNullableString(data, 'relatedEntryId', 160)
        && isValidNullableString(data, 'reason', 300)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidCommissionEntryData(data, businessId, entryId) {
      return data.keys().hasOnly([
          'entryId', 'businessId', 'bookingId', 'studioId', 'dateKey', 'operatorUid',
          'entryType', 'direction', 'amountMinor', 'currency', 'method', 'rateOrValue',
          'basis', 'basisAmountMinor', 'source', 'relatedEntryId', 'reason', 'status',
          'schemaVersion', 'createdAt', 'createdBy'
        ])
        && data.entryId == entryId
        && data.businessId == businessId
        && data.bookingId is string && data.bookingId.size() >= 1
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.operatorUid is string && data.operatorUid.size() >= 1
        && data.entryType in ['EARNED', 'ADJUSTMENT', 'REVERSAL']
        && data.direction in ['credit', 'debit']
        && data.amountMinor is int && data.amountMinor >= 0
        && data.currency == 'IDR'
        && data.method in ['inherit', 'none', 'percentage', 'fixed_per_booking']
        && data.rateOrValue is int && data.rateOrValue >= 0
        && data.basis in ['subtotal', 'settled_amount']
        && data.basisAmountMinor is int && data.basisAmountMinor >= 0
        && data.source is string && data.source.size() >= 1
        && isValidNullableString(data, 'relatedEntryId', 160)
        && isValidNullableString(data, 'reason', 300)
        && data.status in ['RECORDED', 'ADJUSTED', 'REVERSED']
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidNotificationData(data, businessId, notificationId) {
      return data.keys().hasOnly([
          'notificationId', 'businessId', 'studioId', 'recipientUid', 'eventId',
          'type', 'channel', 'entityType', 'entityId', 'title', 'message',
          'actionPath', 'readAt', 'createdBy', 'createdAt', 'schemaVersion'
        ])
        && data.notificationId == notificationId
        && data.businessId == businessId
        && isValidNullableString(data, 'studioId', 128)
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid != '*'
        && data.eventId is string && data.eventId.size() >= 1
        && data.type in [
          'BOOKING_CREATED', 'BOOKING_CONFIRMED', 'BOOKING_STARTED',
          'BOOKING_COMPLETED', 'BOOKING_CANCELLED', 'BOOKING_RESCHEDULED',
          'BOOKING_SETTLED', 'SETTLEMENT_REVIEW_REQUIRED', 'TEAM_ASSIGNMENT_UPDATED'
        ]
        && data.channel == 'in_app'
        && data.entityType in ['booking', 'settlement', 'member']
        && data.entityId is string && data.entityId.size() >= 1
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && isValidNullableString(data, 'actionPath', 160)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidGalleryAssetData(data, businessId, assetId) {
      return data.keys().hasOnly([
          'assetId', 'businessId', 'studioId', 'publicId', 'secureUrl', 'format',
          'width', 'height', 'bytes', 'caption', 'altText', 'order', 'status',
          'uploadedBy', 'uploadedAt', 'createdAt', 'updatedAt', 'updatedBy', 'schemaVersion'
        ])
        && data.assetId == assetId
        && data.businessId == businessId
        && isValidNullableString(data, 'studioId', 100)
        && data.publicId is string && data.publicId.size() >= 1 && data.publicId.size() <= 240
        && data.secureUrl is string
        && data.secureUrl.size() > 27 && data.secureUrl.size() <= 500
        && data.secureUrl.matches('^https://res\\.cloudinary\\.com/.+')
        && data.format in ['jpg', 'jpeg', 'png', 'webp']
        && data.width is int && data.width >= 1 && data.width <= 20000
        && data.height is int && data.height >= 1 && data.height <= 20000
        && data.bytes is int && data.bytes >= 1 && data.bytes <= 52428800
        && isValidNullableString(data, 'caption', 200)
        && isValidNullableString(data, 'altText', 200)
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.status in ['active', 'archived']
        && data.uploadedBy is string && data.uploadedBy.size() >= 1
        && isValidNullableString(data, 'updatedBy', 128)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    // -------------------------------------------------------------------------
    // Global user profile (must NEVER contain role/permission/business access)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && isValidUserProfileData(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
        && isValidUserProfileData(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection group query for discovering own business memberships
    // -------------------------------------------------------------------------
    match /{path=**}/members/{memberUid} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Tenant-scoped business root & master data (Phase 01 + Phase 02)
    // -------------------------------------------------------------------------
    match /businesses/{businessId} {
      allow get: if hasActiveMembership(businessId);
      allow list: if false;

      // Initial business creation (atomic with founder active owner doc)
      allow create: if isSignedIn()
        && !exists(businessPath(businessId))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidBusinessData(request.resource.data, businessId)
        && getAfter(memberPath(businessId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberPath(businessId, request.auth.uid)).data.role == 'owner'
        && getAfter(memberPath(businessId, request.auth.uid)).data.status == 'active';

      allow update: if isOwner(businessId)
        && isValidBusinessData(request.resource.data, businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isOwner(businessId) || (isSelf(memberUid) && (resource == null || resource.data.uid == request.auth.uid));
        allow list: if isOwner(businessId);

        allow create: if isValidMemberData(request.resource.data, memberUid)
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            isOwner(businessId)
            || (
              isSelf(memberUid)
              && !exists(businessPath(businessId))
              && request.resource.data.role == 'owner'
              && request.resource.data.status == 'active'
              && getAfter(businessPath(businessId)).data.ownerUid == request.auth.uid
              && getAfter(businessPath(businessId)).data.businessId == businessId
            )
          );

        allow update: if isOwner(businessId)
          && isValidMemberData(request.resource.data, memberUid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (!isSelf(memberUid) || (request.resource.data.role == 'owner' && request.resource.data.status == 'active'));

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Business Profile (`profile/main`)
      // -----------------------------------------------------------------------
      match /profile/{docId} {
        allow get: if docId == 'main' && hasActiveMembership(businessId);
        allow list: if false;

        allow create: if isOwner(businessId)
          && docId == 'main'
          && isValidBusinessProfileData(request.resource.data, businessId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && docId == 'main'
          && isValidBusinessProfileData(request.resource.data, businessId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Settings (`business | schedule | pricing | commission | bookingPolicy`)
      // -----------------------------------------------------------------------
      match /settings/{settingId} {
        allow get, list: if hasActiveMembership(businessId);

        allow create: if isOwner(businessId)
          && settingId in ['business', 'schedule', 'pricing', 'commission', 'bookingPolicy']
          && isValidSettingData(request.resource.data, businessId, settingId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && settingId in ['business', 'schedule', 'pricing', 'commission', 'bookingPolicy']
          && isValidSettingData(request.resource.data, businessId, settingId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.settingId == resource.data.settingId
          && request.resource.data.configVersion >= resource.data.configVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Studios / Rooms (Owner full; Operator read assigned only)
      // -----------------------------------------------------------------------
      match /studios/{studioId} {
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && studioId in currentMember(businessId).assignedStudioIds
            && (resource == null || resource.data.studioId == studioId)
          );
        allow list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if isOwner(businessId)
          && isValidStudioData(request.resource.data, businessId, studioId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && isValidStudioData(request.resource.data, businessId, studioId)
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Services & Versioned Pricing Config
      // -----------------------------------------------------------------------
      match /services/{serviceId} {
        allow get, list: if hasActiveMembership(businessId);

        allow create: if isOwner(businessId)
          && isValidServiceData(request.resource.data, businessId, serviceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && isValidServiceData(request.resource.data, businessId, serviceId)
          && request.resource.data.serviceId == resource.data.serviceId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.configVersion >= resource.data.configVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Customers (Owner full CRUD sans delete; Operator active operational access)
      // -----------------------------------------------------------------------
      match /customers/{customerId} {
        allow get, list: if canAccessCustomers(businessId);

        allow create: if canAccessCustomers(businessId)
          && isValidCustomerData(request.resource.data, businessId, customerId)
          && (isOwner(businessId) || request.resource.data.status == 'active')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canAccessCustomers(businessId)
          && isValidCustomerData(request.resource.data, businessId, customerId)
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.businessId == resource.data.businessId
          && (isOwner(businessId) || request.resource.data.status == resource.data.status)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 03: Booking Engine, Atomic Slot Locks & Append-Only Activity Logs
      // -----------------------------------------------------------------------
      match /bookings/{bookingId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              resource == null
              || resource.data.studioId in currentMember(businessId).assignedStudioIds
            )
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidBookingData(request.resource.data, businessId, bookingId)
          && request.resource.data.status in ['PENDING_CONFIRMATION', 'CONFIRMED']
          && request.resource.data.rescheduleCount == 0
          && exists(studioPath(businessId, request.resource.data.studioId))
          && get(studioPath(businessId, request.resource.data.studioId)).data.status == 'active'
          && (
            request.resource.data.priceSnapshot.discountMinor == 0
            || isOwner(businessId)
            || (
              currentMember(businessId).get(['permissions', 'canApplyDiscount'], false) == true
              && exists(settingPath(businessId, 'pricing'))
              && get(settingPath(businessId, 'pricing')).data.allowOperatorDiscount == true
            )
          )
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastOperationType == 'booking.create'
          && hasMatchingBookingOperationAfter(
            businessId, bookingId, request.resource.data.studioId,
            request.resource.data, 'booking.create'
          )
          && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'create';

        allow update: if isValidBookingSessionUpdate(
            businessId, bookingId, resource.data, request.resource.data
          )
          || (
            // Request decision: confirm only. Rejection/cancellation are session actions.
            canOperateStudioBooking(businessId, resource.data.studioId)
            && resource.data.status == 'PENDING_CONFIRMATION'
            && request.resource.data.status == 'CONFIRMED'
            && request.resource.data.sessionStatus == 'UPCOMING'
            && request.resource.data.lastOperationType == 'booking.decision'
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'sessionStatus', 'lastOperationId',
              'lastOperationType', 'lastOperationPayloadHash', 'updatedBy', 'updatedAt'
            ])
            && hasMatchingBookingOperationAfter(
              businessId, bookingId, resource.data.studioId,
              request.resource.data, 'booking.decision'
            )
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'decision:CONFIRMED'
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.resultBookingStatus == 'CONFIRMED'
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.resultSessionStatus == 'UPCOMING'
          )
          || (
            // Atomic reschedule: marker and all slot changes share one transaction.
            canOperateStudioBooking(businessId, resource.data.studioId)
            && resource.data.status in ['PENDING_CONFIRMATION', 'CONFIRMED']
            && request.resource.data.status == resource.data.status
            && request.resource.data.rescheduleCount == resource.data.rescheduleCount + 1
            && request.resource.data.lastOperationType == 'booking.reschedule'
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'dateKey', 'timezone', 'startTime', 'endTime', 'durationMinutes',
              'bufferMinutes', 'startAt', 'endAt', 'slotIds',
              'priceSnapshot', 'commissionSnapshot', 'rescheduleCount', 'updatedBy', 'updatedAt',
              'lastOperationId', 'lastOperationType', 'lastOperationPayloadHash'
            ])
            && hasMatchingBookingOperationAfter(
              businessId, bookingId, resource.data.studioId,
              request.resource.data, 'booking.reschedule'
            )
            && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'reschedule'
            && request.resource.data.endAt > request.resource.data.startAt
            && request.resource.data.slotIds is list
            && request.resource.data.slotIds.size() >= 1
            && request.resource.data.slotIds.size() <= 96
            && (
              request.resource.data.durationMinutes != resource.data.durationMinutes
              || (
                request.resource.data.priceSnapshot == resource.data.priceSnapshot
                && request.resource.data.commissionSnapshot == resource.data.commissionSnapshot
              )
            )
          )
          || (
            // Owner-only Finance handoff remains unchanged.
            isOwner(businessId)
            && request.resource.data.updatedBy == request.auth.uid
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'settlement', 'updatedBy', 'updatedAt'
            ])
            && (
              (
                resource.data.status == 'COMPLETED_PENDING_SETTLEMENT'
                && request.resource.data.status == 'SETTLEMENT_REVIEW'
              )
              || (
                resource.data.status in ['COMPLETED_PENDING_SETTLEMENT', 'SETTLEMENT_REVIEW']
                && request.resource.data.status == 'SETTLED'
                && request.resource.data.settlement is map
                && request.resource.data.settlement.paidAmountMinor is int
                && request.resource.data.settlement.paidAmountMinor >= 0
                && request.resource.data.settlement.ledgerEntryId == ('settlement_payment__' + bookingId)
                && request.resource.data.settlement.commissionEntryId == ('commission_earned__' + bookingId)
                && existsAfter(ledgerEntryPath(businessId, 'settlement_payment__' + bookingId))
                && existsAfter(commissionEntryPath(businessId, 'commission_earned__' + bookingId))
              )
            )
          );

        allow delete: if false;
      }

      match /bookingSlots/{slotId} {
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              (resource != null && resource.data.studioId in currentMember(businessId).assignedStudioIds)
              || (
                resource == null
                && slotId.split('__').size() == 3
                && slotId.split('__')[0] in currentMember(businessId).assignedStudioIds
              )
            )
          );

        allow list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidBookingSlotData(request.resource.data, businessId, slotId)
          && request.resource.data.status == 'active'
          && request.resource.data.reservedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.reservedAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canOperateStudioBooking(businessId, resource.data.studioId)
          && isValidBookingSlotData(request.resource.data, businessId, slotId)
          && request.resource.data.slotId == resource.data.slotId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.bucketIndex == resource.data.bucketIndex
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'released' && request.resource.data.status == 'active')
            || (resource.data.status == 'active' && request.resource.data.status == 'released')
            || (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && request.resource.data.bookingId == resource.data.bookingId
            )
          );

        allow delete: if false;
      }

      match /activityLogs/{eventId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource != null
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidActivityLogData(request.resource.data, businessId, eventId)
          && (
            isOwner(businessId)
            || (
              request.resource.data.entityType == 'booking'
              && !(request.resource.data.eventType in [
                'booking.settled', 'booking.settlement_review', 'ledger.adjusted', 'commission.adjusted'
              ])
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 04: Immutable Financial Ledger & Operator Commission Entries
      // -----------------------------------------------------------------------
      match /ledgerEntries/{entryId} {
        allow get, list: if isOwner(businessId);

        allow create: if isOwner(businessId)
          && isValidLedgerEntryData(request.resource.data, businessId, entryId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.relatedEntryId == null
            || exists(ledgerEntryPath(businessId, request.resource.data.relatedEntryId))
          );

        allow update, delete: if false;
      }

      match /commissionEntries/{entryId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource != null
            && resource.data.operatorUid == request.auth.uid
          );

        allow create: if isOwner(businessId)
          && isValidCommissionEntryData(request.resource.data, businessId, entryId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.relatedEntryId == null
            || exists(commissionEntryPath(businessId, request.resource.data.relatedEntryId))
          );

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 05: Scoped In-App Notifications
      // -----------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get, list: if hasActiveMembership(businessId)
          && resource != null
          && resource.data.recipientUid == request.auth.uid;

        allow create: if isValidNotificationData(request.resource.data, businessId, notificationId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null
          && exists(memberPath(businessId, request.resource.data.recipientUid))
          && (
            isOwner(businessId)
            || (
              hasActiveMembership(businessId)
              && request.resource.data.studioId != null
              && request.resource.data.studioId in currentMember(businessId).assignedStudioIds
              && request.resource.data.type in [
                'BOOKING_CREATED', 'BOOKING_CONFIRMED', 'BOOKING_STARTED',
                'BOOKING_COMPLETED', 'BOOKING_CANCELLED', 'BOOKING_RESCHEDULED'
              ]
            )
          );

        allow update: if hasActiveMembership(businessId)
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 06: Gallery Assets (Cloudinary Metadata & Soft-Archive)
      // -----------------------------------------------------------------------
      match /galleryAssets/{assetId} {
        allow read: if hasActiveMembership(businessId);

        allow create: if canManageGallery(businessId)
          && isValidGalleryAssetData(request.resource.data, businessId, assetId)
          && request.resource.data.status == 'active'
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (
            (
              canManageGallery(businessId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['studioId', 'caption', 'altText', 'order', 'updatedBy', 'updatedAt'])
            )
            || (
              isOwner(businessId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['studioId', 'caption', 'altText', 'order', 'status', 'updatedBy', 'updatedAt'])
              && request.resource.data.status in ['active', 'archived']
            )
          )
          && isValidNullableString(request.resource.data, 'studioId', 100)
          && isValidNullableString(request.resource.data, 'caption', 200)
          && isValidNullableString(request.resource.data, 'altText', 200)
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 10000
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.publicId == resource.data.publicId
          && request.resource.data.secureUrl == resource.data.secureUrl
          && request.resource.data.format == resource.data.format
          && request.resource.data.width == resource.data.width
          && request.resource.data.height == resource.data.height
          && request.resource.data.bytes == resource.data.bytes
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.uploadedAt == resource.data.uploadedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.assetId == resource.data.assetId;

        allow delete: if false;
      }
    }

    // Default deny fallback for every other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
          && request.resource.data.resultBookingStatus is string
          && request.resource.data.resultSessionStatus is string
          && request.resource.data.schemaVersion is int
          && request.resource.data.schemaVersion >= 1
          && request.resource.data.createdAt == request.time
          && existsAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId))
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)).data.lastOperationId == operationId
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)).data.lastOperationType == request.resource.data.operationType
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)).data.lastOperationPayloadHash == request.resource.data.payloadHash
          && getAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)).data.status == request.resource.data.resultBookingStatus
          && (
            !('sessionStatus' in getAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)).data)
            || getAfter(/databases/$(database)/documents/businesses/$(businessId)/bookings/$(request.resource.data.bookingId)).data.sessionStatus == request.resource.data.resultSessionStatus
          )
          && (
            request.resource.data.operationType != 'booking.session'
            || (
              existsAfter(bookingSessionEventPath(businessId, operationId))
              && getAfter(bookingSessionEventPath(businessId, operationId)).data.operationId == operationId
              && getAfter(bookingSessionEventPath(businessId, operationId)).data.bookingId == request.resource.data.bookingId
              && getAfter(bookingSessionEventPath(businessId, operationId)).data.action == request.resource.data.action
            )
          );

        allow update, delete: if false;
      }

      // Phase 10: append-only operational history, independent from Finance activity logs.
      match /bookingSessionEvents/{eventId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && request.resource.data.keys().hasOnly([
            'eventId', 'businessId', 'bookingId', 'studioId', 'action',
            'fromStatus', 'toStatus', 'actorUid', 'actorRole', 'actorName',
            'reason', 'operationId', 'requestId', 'payloadHash', 'schemaVersion', 'createdAt'
          ])
          && request.resource.data.eventId == eventId
          && request.resource.data.operationId == eventId
          && request.resource.data.businessId == businessId
          && request.resource.data.bookingId is string
          && request.resource.data.studioId is string
          && request.resource.data.action in ['check_in', 'start', 'complete', 'no_show', 'cancel', 'reject']
          && request.resource.data.fromStatus in ['PENDING', 'UPCOMING', 'IN_PROGRESS']
          && request.resource.data.toStatus in ['PENDING', 'UPCOMING', 'IN_PROGRESS', 'COMPLETED', 'NO_SHOW', 'CANCELLED']
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == currentMember(businessId).role
          && request.resource.data.actorName is string
          && request.resource.data.actorName.size() >= 1
          && request.resource.data.actorName.size() <= 120
          && isValidNullableString(request.resource.data, 'reason', 300)
          && request.resource.data.requestId is string
          && request.resource.data.requestId.size() >= 8
          && request.resource.data.payloadHash is string
          && request.resource.data.payloadHash.matches('^[a-f0-9]{16,64}
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              (resource != null && resource.data.studioId in currentMember(businessId).assignedStudioIds)
              || (
                resource == null
                && slotId.split('__').size() == 3
                && slotId.split('__')[0] in currentMember(businessId).assignedStudioIds
              )
            )
          );

        allow list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidBookingSlotData(request.resource.data, businessId, slotId)
          && request.resource.data.status == 'active'
          && request.resource.data.reservedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.reservedAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canOperateStudioBooking(businessId, resource.data.studioId)
          && isValidBookingSlotData(request.resource.data, businessId, slotId)
          && request.resource.data.slotId == resource.data.slotId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.bucketIndex == resource.data.bucketIndex
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (
            (resource.data.status == 'released' && request.resource.data.status == 'active')
            || (resource.data.status == 'active' && request.resource.data.status == 'released')
            || (
              resource.data.status == 'active'
              && request.resource.data.status == 'active'
              && request.resource.data.bookingId == resource.data.bookingId
            )
          );

        allow delete: if false;
      }

      match /activityLogs/{eventId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource != null
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidActivityLogData(request.resource.data, businessId, eventId)
          && (
            isOwner(businessId)
            || (
              request.resource.data.entityType == 'booking'
              && !(request.resource.data.eventType in [
                'booking.settled', 'booking.settlement_review', 'ledger.adjusted', 'commission.adjusted'
              ])
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 04: Immutable Financial Ledger & Operator Commission Entries
      // -----------------------------------------------------------------------
      match /ledgerEntries/{entryId} {
        allow get, list: if isOwner(businessId);

        allow create: if isOwner(businessId)
          && isValidLedgerEntryData(request.resource.data, businessId, entryId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.relatedEntryId == null
            || exists(ledgerEntryPath(businessId, request.resource.data.relatedEntryId))
          );

        allow update, delete: if false;
      }

      match /commissionEntries/{entryId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource != null
            && resource.data.operatorUid == request.auth.uid
          );

        allow create: if isOwner(businessId)
          && isValidCommissionEntryData(request.resource.data, businessId, entryId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.relatedEntryId == null
            || exists(commissionEntryPath(businessId, request.resource.data.relatedEntryId))
          );

        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 05: Scoped In-App Notifications
      // -----------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get, list: if hasActiveMembership(businessId)
          && resource != null
          && resource.data.recipientUid == request.auth.uid;

        allow create: if isValidNotificationData(request.resource.data, businessId, notificationId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.readAt == null
          && exists(memberPath(businessId, request.resource.data.recipientUid))
          && (
            isOwner(businessId)
            || (
              hasActiveMembership(businessId)
              && request.resource.data.studioId != null
              && request.resource.data.studioId in currentMember(businessId).assignedStudioIds
              && request.resource.data.type in [
                'BOOKING_CREATED', 'BOOKING_CONFIRMED', 'BOOKING_STARTED',
                'BOOKING_COMPLETED', 'BOOKING_CANCELLED', 'BOOKING_RESCHEDULED'
              ]
            )
          );

        allow update: if hasActiveMembership(businessId)
          && resource.data.recipientUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 06: Gallery Assets (Cloudinary Metadata & Soft-Archive)
      // -----------------------------------------------------------------------
      match /galleryAssets/{assetId} {
        allow read: if hasActiveMembership(businessId);

        allow create: if canManageGallery(businessId)
          && isValidGalleryAssetData(request.resource.data, businessId, assetId)
          && request.resource.data.status == 'active'
          && request.resource.data.uploadedBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.uploadedAt == request.time
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if (
            (
              canManageGallery(businessId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['studioId', 'caption', 'altText', 'order', 'updatedBy', 'updatedAt'])
            )
            || (
              isOwner(businessId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['studioId', 'caption', 'altText', 'order', 'status', 'updatedBy', 'updatedAt'])
              && request.resource.data.status in ['active', 'archived']
            )
          )
          && isValidNullableString(request.resource.data, 'studioId', 100)
          && isValidNullableString(request.resource.data, 'caption', 200)
          && isValidNullableString(request.resource.data, 'altText', 200)
          && request.resource.data.order is int
          && request.resource.data.order >= 0
          && request.resource.data.order <= 10000
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.publicId == resource.data.publicId
          && request.resource.data.secureUrl == resource.data.secureUrl
          && request.resource.data.format == resource.data.format
          && request.resource.data.width == resource.data.width
          && request.resource.data.height == resource.data.height
          && request.resource.data.bytes == resource.data.bytes
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.uploadedAt == resource.data.uploadedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.assetId == resource.data.assetId;

        allow delete: if false;
      }
    }

    // Default deny fallback for every other path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
)
          )
        )
        && data.studioSnapshot is map
        && data.serviceSnapshot is map
        && data.customerSnapshot is map
        && data.priceSnapshot is map
        && data.priceSnapshot.currency == 'IDR'
        && data.priceSnapshot.totalMinor is int && data.priceSnapshot.totalMinor >= 0
        && data.priceSnapshot.discountMinor is int && data.priceSnapshot.discountMinor >= 0
        && data.commissionSnapshot is map
        && data.commissionSnapshot.currency == 'IDR'
        && data.commissionSnapshot.amountMinor is int && data.commissionSnapshot.amountMinor >= 0
        && (!('settlement' in data) || data.settlement == null || data.settlement is map)
        && isValidNullableString(data, 'notes', 500)
        && isValidNullableString(data, 'cancelReason', 300)
        && isValidNullableString(data, 'cancelledBy', 128)
        && data.rescheduleCount is int && data.rescheduleCount >= 0
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidBookingSlotData(data, businessId, slotId) {
      return data.keys().hasOnly([
          'slotId', 'businessId', 'studioId', 'dateKey', 'bucketIndex', 'slotTime',
          'kind', 'status', 'bookingId', 'slotStartAt', 'slotEndAt',
          'reservedBy', 'reservedAt', 'releasedAt', 'schemaVersion', 'updatedAt', 'updatedBy'
        ])
        && data.slotId == slotId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.bucketIndex is int && data.bucketIndex >= 0 && data.bucketIndex <= 95
        && (
          (data.bucketIndex < 10 && slotId == data.studioId + '__' + data.dateKey + '__0' + string(data.bucketIndex))
          || (data.bucketIndex >= 10 && slotId == data.studioId + '__' + data.dateKey + '__' + string(data.bucketIndex))
        )
        && data.slotTime is string && data.slotTime.matches('^([01][0-9]|2[0-3]):(00|15|30|45)$')
        && data.kind in ['session', 'buffer']
        && data.status in ['active', 'released']
        && (
          (data.status == 'active' && data.bookingId is string && data.bookingId.size() >= 1)
          || (data.status == 'released' && data.bookingId == null)
        )
        && data.slotStartAt is timestamp
        && data.slotEndAt is timestamp
        && data.slotEndAt > data.slotStartAt
        && data.reservedBy is string && data.reservedBy.size() >= 1
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidActivityLogData(data, businessId, eventId) {
      return data.keys().hasOnly([
          'eventId', 'businessId', 'studioId', 'eventType', 'entityType', 'entityId',
          'operationId', 'actorUid', 'actorRole', 'beforeStatus', 'afterStatus',
          'reason', 'summary', 'schemaVersion', 'createdAt'
        ])
        && data.eventId == eventId
        && data.businessId == businessId
        && data.studioId is string && data.studioId.size() >= 1
        && data.entityType in ['booking', 'ledger_entry', 'commission_entry']
        && data.entityId is string && data.entityId.size() >= 1
        && data.operationId is string && data.operationId.size() >= 1
        && data.eventType in [
          'booking.created', 'booking.confirmed', 'booking.started',
          'booking.completed', 'booking.cancelled', 'booking.no_show', 'booking.rescheduled',
          'booking.settled', 'booking.settlement_review', 'ledger.adjusted', 'commission.adjusted'
        ]
        && data.actorUid == request.auth.uid
        && data.actorRole == currentMember(businessId).role
        && isValidNullableString(data, 'beforeStatus', 60)
        && data.afterStatus is string && data.afterStatus.size() >= 1
        && isValidNullableString(data, 'reason', 300)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidLedgerEntryData(data, businessId, entryId) {
      return data.keys().hasOnly([
          'entryId', 'businessId', 'bookingId', 'studioId', 'dateKey',
          'type', 'direction', 'amountMinor', 'currency', 'paymentMethod',
          'reference', 'notes', 'relatedEntryId', 'reason', 'schemaVersion',
          'createdAt', 'createdBy'
        ])
        && data.entryId == entryId
        && data.businessId == businessId
        && data.bookingId is string && data.bookingId.size() >= 1
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.type in ['PAYMENT_RECEIVED', 'REFUND', 'ADJUSTMENT', 'REVERSAL']
        && data.direction in ['inflow', 'outflow']
        && data.amountMinor is int && data.amountMinor >= 0
        && data.currency == 'IDR'
        && (!('paymentMethod' in data) || data.paymentMethod == null || data.paymentMethod in ['cash', 'transfer', 'qris', 'card', 'other'])
        && isValidNullableString(data, 'reference', 120)
        && isValidNullableString(data, 'notes', 300)
        && isValidNullableString(data, 'relatedEntryId', 160)
        && isValidNullableString(data, 'reason', 300)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidCommissionEntryData(data, businessId, entryId) {
      return data.keys().hasOnly([
          'entryId', 'businessId', 'bookingId', 'studioId', 'dateKey', 'operatorUid',
          'entryType', 'direction', 'amountMinor', 'currency', 'method', 'rateOrValue',
          'basis', 'basisAmountMinor', 'source', 'relatedEntryId', 'reason', 'status',
          'schemaVersion', 'createdAt', 'createdBy'
        ])
        && data.entryId == entryId
        && data.businessId == businessId
        && data.bookingId is string && data.bookingId.size() >= 1
        && data.studioId is string && data.studioId.size() >= 1
        && data.dateKey is string && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.operatorUid is string && data.operatorUid.size() >= 1
        && data.entryType in ['EARNED', 'ADJUSTMENT', 'REVERSAL']
        && data.direction in ['credit', 'debit']
        && data.amountMinor is int && data.amountMinor >= 0
        && data.currency == 'IDR'
        && data.method in ['inherit', 'none', 'percentage', 'fixed_per_booking']
        && data.rateOrValue is int && data.rateOrValue >= 0
        && data.basis in ['subtotal', 'settled_amount']
        && data.basisAmountMinor is int && data.basisAmountMinor >= 0
        && data.source is string && data.source.size() >= 1
        && isValidNullableString(data, 'relatedEntryId', 160)
        && isValidNullableString(data, 'reason', 300)
        && data.status in ['RECORDED', 'ADJUSTED', 'REVERSED']
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidNotificationData(data, businessId, notificationId) {
      return data.keys().hasOnly([
          'notificationId', 'businessId', 'studioId', 'recipientUid', 'eventId',
          'type', 'channel', 'entityType', 'entityId', 'title', 'message',
          'actionPath', 'readAt', 'createdBy', 'createdAt', 'schemaVersion'
        ])
        && data.notificationId == notificationId
        && data.businessId == businessId
        && isValidNullableString(data, 'studioId', 128)
        && data.recipientUid is string && data.recipientUid.size() >= 1 && data.recipientUid != '*'
        && data.eventId is string && data.eventId.size() >= 1
        && data.type in [
          'BOOKING_CREATED', 'BOOKING_CONFIRMED', 'BOOKING_STARTED',
          'BOOKING_COMPLETED', 'BOOKING_CANCELLED', 'BOOKING_RESCHEDULED',
          'BOOKING_SETTLED', 'SETTLEMENT_REVIEW_REQUIRED', 'TEAM_ASSIGNMENT_UPDATED'
        ]
        && data.channel == 'in_app'
        && data.entityType in ['booking', 'settlement', 'member']
        && data.entityId is string && data.entityId.size() >= 1
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.message is string && data.message.size() >= 1 && data.message.size() <= 300
        && isValidNullableString(data, 'actionPath', 160)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    function isValidGalleryAssetData(data, businessId, assetId) {
      return data.keys().hasOnly([
          'assetId', 'businessId', 'studioId', 'publicId', 'secureUrl', 'format',
          'width', 'height', 'bytes', 'caption', 'altText', 'order', 'status',
          'uploadedBy', 'uploadedAt', 'createdAt', 'updatedAt', 'updatedBy', 'schemaVersion'
        ])
        && data.assetId == assetId
        && data.businessId == businessId
        && isValidNullableString(data, 'studioId', 100)
        && data.publicId is string && data.publicId.size() >= 1 && data.publicId.size() <= 240
        && data.secureUrl is string
        && data.secureUrl.size() > 27 && data.secureUrl.size() <= 500
        && data.secureUrl.matches('^https://res\\.cloudinary\\.com/.+')
        && data.format in ['jpg', 'jpeg', 'png', 'webp']
        && data.width is int && data.width >= 1 && data.width <= 20000
        && data.height is int && data.height >= 1 && data.height <= 20000
        && data.bytes is int && data.bytes >= 1 && data.bytes <= 52428800
        && isValidNullableString(data, 'caption', 200)
        && isValidNullableString(data, 'altText', 200)
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.status in ['active', 'archived']
        && data.uploadedBy is string && data.uploadedBy.size() >= 1
        && isValidNullableString(data, 'updatedBy', 128)
        && data.schemaVersion is int && data.schemaVersion >= 1;
    }

    // -------------------------------------------------------------------------
    // Global user profile (must NEVER contain role/permission/business access)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get: if isSelf(uid);
      allow list: if false;
      allow create: if isSelf(uid)
        && isValidUserProfileData(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSelf(uid)
        && isValidUserProfileData(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Collection group query for discovering own business memberships
    // -------------------------------------------------------------------------
    match /{path=**}/members/{memberUid} {
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Tenant-scoped business root & master data (Phase 01 + Phase 02)
    // -------------------------------------------------------------------------
    match /businesses/{businessId} {
      allow get: if hasActiveMembership(businessId);
      allow list: if false;

      // Initial business creation (atomic with founder active owner doc)
      allow create: if isSignedIn()
        && !exists(businessPath(businessId))
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isValidBusinessData(request.resource.data, businessId)
        && getAfter(memberPath(businessId, request.auth.uid)).data.uid == request.auth.uid
        && getAfter(memberPath(businessId, request.auth.uid)).data.role == 'owner'
        && getAfter(memberPath(businessId, request.auth.uid)).data.status == 'active';

      allow update: if isOwner(businessId)
        && isValidBusinessData(request.resource.data, businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /members/{memberUid} {
        allow get: if isOwner(businessId) || (isSelf(memberUid) && (resource == null || resource.data.uid == request.auth.uid));
        allow list: if isOwner(businessId);

        allow create: if isValidMemberData(request.resource.data, memberUid)
          && request.resource.data.businessId == businessId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && (
            isOwner(businessId)
            || (
              isSelf(memberUid)
              && !exists(businessPath(businessId))
              && request.resource.data.role == 'owner'
              && request.resource.data.status == 'active'
              && getAfter(businessPath(businessId)).data.ownerUid == request.auth.uid
              && getAfter(businessPath(businessId)).data.businessId == businessId
            )
          );

        allow update: if isOwner(businessId)
          && isValidMemberData(request.resource.data, memberUid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && (!isSelf(memberUid) || (request.resource.data.role == 'owner' && request.resource.data.status == 'active'));

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Business Profile (`profile/main`)
      // -----------------------------------------------------------------------
      match /profile/{docId} {
        allow get: if docId == 'main' && hasActiveMembership(businessId);
        allow list: if false;

        allow create: if isOwner(businessId)
          && docId == 'main'
          && isValidBusinessProfileData(request.resource.data, businessId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && docId == 'main'
          && isValidBusinessProfileData(request.resource.data, businessId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Settings (`business | schedule | pricing | commission | bookingPolicy`)
      // -----------------------------------------------------------------------
      match /settings/{settingId} {
        allow get, list: if hasActiveMembership(businessId);

        allow create: if isOwner(businessId)
          && settingId in ['business', 'schedule', 'pricing', 'commission', 'bookingPolicy']
          && isValidSettingData(request.resource.data, businessId, settingId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && settingId in ['business', 'schedule', 'pricing', 'commission', 'bookingPolicy']
          && isValidSettingData(request.resource.data, businessId, settingId)
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.settingId == resource.data.settingId
          && request.resource.data.configVersion >= resource.data.configVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Studios / Rooms (Owner full; Operator read assigned only)
      // -----------------------------------------------------------------------
      match /studios/{studioId} {
        allow get: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && studioId in currentMember(businessId).assignedStudioIds
            && (resource == null || resource.data.studioId == studioId)
          );
        allow list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && resource.data.studioId in currentMember(businessId).assignedStudioIds
          );

        allow create: if isOwner(businessId)
          && isValidStudioData(request.resource.data, businessId, studioId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && isValidStudioData(request.resource.data, businessId, studioId)
          && request.resource.data.studioId == resource.data.studioId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Services & Versioned Pricing Config
      // -----------------------------------------------------------------------
      match /services/{serviceId} {
        allow get, list: if hasActiveMembership(businessId);

        allow create: if isOwner(businessId)
          && isValidServiceData(request.resource.data, businessId, serviceId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(businessId)
          && isValidServiceData(request.resource.data, businessId, serviceId)
          && request.resource.data.serviceId == resource.data.serviceId
          && request.resource.data.businessId == resource.data.businessId
          && request.resource.data.configVersion >= resource.data.configVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 02: Customers (Owner full CRUD sans delete; Operator active operational access)
      // -----------------------------------------------------------------------
      match /customers/{customerId} {
        allow get, list: if canAccessCustomers(businessId);

        allow create: if canAccessCustomers(businessId)
          && isValidCustomerData(request.resource.data, businessId, customerId)
          && (isOwner(businessId) || request.resource.data.status == 'active')
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if canAccessCustomers(businessId)
          && isValidCustomerData(request.resource.data, businessId, customerId)
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.businessId == resource.data.businessId
          && (isOwner(businessId) || request.resource.data.status == resource.data.status)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // Phase 03: Booking Engine, Atomic Slot Locks & Append-Only Activity Logs
      // -----------------------------------------------------------------------
      match /bookings/{bookingId} {
        allow get, list: if isOwner(businessId)
          || (
            hasActiveMembership(businessId)
            && currentMember(businessId).get(['permissions', 'canManageBookings'], false) == true
            && (
              resource == null
              || resource.data.studioId in currentMember(businessId).assignedStudioIds
            )
          );

        allow create: if canOperateStudioBooking(businessId, request.resource.data.studioId)
          && isValidBookingData(request.resource.data, businessId, bookingId)
          && request.resource.data.status in ['PENDING_CONFIRMATION', 'CONFIRMED']
          && request.resource.data.rescheduleCount == 0
          && exists(studioPath(businessId, request.resource.data.studioId))
          && get(studioPath(businessId, request.resource.data.studioId)).data.status == 'active'
          && (
            request.resource.data.priceSnapshot.discountMinor == 0
            || isOwner(businessId)
            || (
              currentMember(businessId).get(['permissions', 'canApplyDiscount'], false) == true
              && exists(settingPath(businessId, 'pricing'))
              && get(settingPath(businessId, 'pricing')).data.allowOperatorDiscount == true
            )
          )
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.lastOperationType == 'booking.create'
          && hasMatchingBookingOperationAfter(
            businessId, bookingId, request.resource.data.studioId,
            request.resource.data, 'booking.create'
          )
          && getAfter(bookingOperationPath(businessId, request.resource.data.lastOperationId)).data.action == 'create';

        allow update: if isValidBookingSessionUpdate(
            businessId, bookingId, resource.data, request.resource.data
          )
          || (
            // Request decision: confirm only. Rejection/cancellation are session actions.
            canOperateStudioBooking(businessId, resource.data.studioId)
            && resource.data.status == 'PENDING_CONFIRMATION'
            && request.resource.data.status == 'CONFIRMED'
            && request.resource.data.sessionStatus == 'UPCOMING'
            && request.resource.data.lastOperationType == 'booking.decision'
