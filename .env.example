# Application Environment ("development" | "staging" | "production")
VITE_APP_ENV=development

# Firebase Web App Configuration (obtain from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Single-business ID shortcut for initial studio bootstrap
VITE_DEFAULT_BUSINESS_ID=

# Optional: Local Firebase Emulator Suite connection (set true for local emulator dev)
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Optional: Firebase App Check reCAPTCHA v3 / Enterprise site key
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Cloudinary Gallery (Phase 06 - NEVER place API Secret here)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
